# Since .env is gitignored, use this file as the local environment template.

# waslaeuftin web app
DATABASE_URL="postgresql://user:password@localhost:5432/waslaeuftin"
GITHUB_TOKEN="your-github-token-here"
TMDB_API_KEY="your-tmdb-api-key"
TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p"
TMDB_POSTER_SIZE="w780"
TMDB_MIN_CONFIDENCE_SCORE="0.68"
EXPO_ACCESS_TOKEN="your-expo-access-token"
# Any S3-compatible storage (versitygw, MinIO, AWS S3, ...).
S3_ENDPOINT="https://s3.example.com"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-s3-access-key"
S3_SECRET_ACCESS_KEY="your-s3-secret-key"
S3_FORCE_PATH_STYLE="true"
S3_BUCKET="waslaeuftin"
S3_MOVIE_COVERS_PREFIX="waslaeuftin/tmdb-covers"
S3_PUBLIC_BASE_URL="https://s3.example.com/waslaeuftin"
UMAMI_URL="https://analytics.example.com"
UMAMI_WEBSITE_ID="your-website-id"
UMAMI_VIEW_DEDUPLICATION_SECONDS="300"
# /admin (movie update runs) is disabled unless ADMIN_PASSWORD is set.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
# Nightly movie updates inside the web server (Europe/Berlin). Set to "off" to disable.
MOVIE_UPDATE_CRON="0 3 * * *"
# Optional: Pushover notifications for failed provider updates.
PUSHOVER_TOKEN=""
PUSHOVER_USER=""
