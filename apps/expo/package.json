{
  "name": "@waslaeuftin/expo",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "clean": "git clean -xdf .cache .expo .turbo android ios node_modules",
    "dev": "expo start --go",
    "dev:android": "expo start --go --android",
    "dev:ios": "expo start --go --ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android:apk": "bash scripts/build-android-apk.sh",
    "build:android:playstore": "bash scripts/build-android-playstore.sh",
    "build:ios:altstore": "bash scripts/build-ios-altstore.sh",
    "build:ios:appstore": "bash scripts/build-ios-appstore.sh",
    "update:production": "eas update --auto",
    "update:preview": "eas update --channel preview",
    "format": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "lint": "eslint --flag unstable_native_nodejs_ts_config",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/ui": "~57.0.14",
    "@expo/vector-icons": "^15.1.1",
    "@legendapp/list": "^3.3.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "catalog:",
    "@waslaeuftin/core": "workspace:*",
    "expo": "^57.0.17",
    "expo-constants": "~57.0.15",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.8",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.18",
    "expo-web-browser": "~57.0.2",
    "lightningcss": "1.30.1",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css": "3.0.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "superjson": "catalog:",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/react": "catalog:react19",
    "@waslaeuftin/api": "workspace:*",
    "@waslaeuftin/eslint-config": "workspace:*",
    "@waslaeuftin/prettier-config": "workspace:*",
    "@waslaeuftin/tailwind-config": "workspace:*",
    "@waslaeuftin/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "metro-cache": "^0.87.0",
    "postcss": "catalog:",
    "prettier": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "prettier": "@waslaeuftin/prettier-config"
